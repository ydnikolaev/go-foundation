# managed by devkit — do not edit; fix upstream in ~/Developer/projects/devkit
# Rendered from the answers in .copier-answers.devkit.yml. Read by scripts/kit/*. KEY=VALUE only.
KIT_PROJECT=go-foundation
KIT_PREFIX=GF
KIT_ID_PREFIX=GF
KIT_PORT_BASE=7800
KIT_PORT_SPAN=100
KIT_TRUNK=main
KIT_DEPLOY_BRANCHES=detect
KIT_QUEUE_CORES=6
KIT_QUEUE_CORES_MAP=
# heavy_targets and light_targets class a goal typed by hand for the queue; no list names a verb of the vocabulary (check, check-full,
# check-docker, check-only, test, lint, fmt, sweep, e2e, help): kit-verbs refuses it (V5), and a name no rule defines (V6).
KIT_HEAVY_TARGETS=
KIT_LIGHT_TARGETS=
# KIT_BASE_SETUP_STEP (empty = none): a project script, a path relative to the base worktree, run once before the base run's first row; config/ports.env overrides it.
KIT_BASE_SETUP_STEP=

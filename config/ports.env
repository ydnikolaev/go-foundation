# go-foundation host port map: the ONLY place a port number is written (standards/ports.md).
# Block 7800-7899 from the host registry (~/Developer/_ops/registry/ports.yaml); 7890-7899 stay reserved.
# KEY=VALUE only, with no trailing comments: sourceable by sh, includable by make, usable as `docker compose --env-file`.
# Compose binds loopback only: "127.0.0.1:${GF_WEB_PORT}:<container port>". Busy port => fail loudly, never move to a neighbour. Only a test stack reached from another container via host.docker.internal may bind all interfaces (port still from here, a comment in compose says why).
#
# Uncomment what this repo binds; add worktree slots as <PREFIX>_WT_PORT_BASE inside the block.
# GF_API_PORT=7801
# GF_DB_PORT=7810
# GF_DB_TEST_PORT=7811
# GF_MAIL_SMTP_PORT=7820
# GF_MAIL_UI_PORT=7821
# GF_S3_PORT=7830
# GF_E2E_WEB_PORT=7850
# GF_E2E_API_PORT=7851
# GF_SIM_PORT=7852
# GF_TEST_PORT=7853
# GF_CHECK_PORT=7854
# GF_WT_PORT_BASE=7860

GF_WEB_PORT=7800
